# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Must match BOT_API_KEY in the Next.js app's .env
BOT_API_KEY=generate-with-openssl-rand-hex-32

# Groq API Key (get free from console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key

# Base URL of the Next.js app (no trailing slash)
STUDY_HUB_BASE_URL=https://your-app.vercel.app
