// Sudan Scholars Hub - Database Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ADMIN AUTH ============
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role      @default(EDITOR)
  otpCode      String?   // 6-digit OTP code (hashed)
  otpExpiresAt DateTime? // OTP expiration time
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

// ============ USER AUTH (Google OAuth) ============
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?   // Google profile picture
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Extended profile fields
  phone          String?
  location       String?
  bio            String?   @db.Text
  educationLevel String?   // HIGH_SCHOOL, BACHELOR, MASTER, PHD
  fieldOfStudy   String?   // ENGINEERING, MEDICINE, BUSINESS, etc.
  socialLinks    Json?     // { twitter?: string, linkedin?: string, facebook?: string, website?: string }
  profileImage   String?   // Custom uploaded profile picture (overrides Google image)

  // Student identity
  studentNumber  String?   @unique

  // Study Hub gamification
  points         Int       @default(0)
  badge          String?

  accounts          Account[]
  savedScholarships SavedScholarship[]
  matcherProfile    MatcherProfile?
  resumes           Resume[]
  studyMaterials    StudyMaterial[]
  pastExams         PastExam[]
  savedMaterials    SavedMaterial[]
  materialReviews   MaterialReview[]
  notifications     Notification[]
  materialRequests  MaterialRequest[]
  studyGroups       StudyGroup[]
  collections       MaterialCollection[]
  professorReviews      ProfessorReview[]
  professorReviewVotes  ProfessorReviewVote[]
  aiChatSessions        AIChatSession[]
  flashcardDecks        FlashcardDeck[]
  flashcardReviews      FlashcardReview[]
  studySessions         StudySession[]
  studyGoals            StudyGoal[]
  studyStreak           StudyStreak?
  studyExams            StudyExam[]
  smartStudyPaths       SmartStudyPath[]
  topicMasteries        TopicMastery[]
  focusIsland           FocusIsland?
  battleQuestions       BattleQuestion[]
  battlesAsChallenger   Battle[]  @relation("challenger")
  battlesAsOpponent     Battle[]  @relation("opponent")
  ieltsToeflTests       IeltsToeflTest[]
  ieltsToeflAttempts    IeltsToeflAttempt[]
  ieltsToeflVocabProgress IeltsToeflVocabProgress[]
  ieltsToeflMaterials     IeltsToeflMaterial[]
}

// OAuth Account linking (required by NextAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============ SCHOLARSHIPS ============
model Scholarship {
  id         String   @id @default(cuid())
  slug       String   @unique

  // English content
  title        String
  university   String
  country      String
  countryCode  String
  description  String   @db.Text
  eligibility  String[]
  benefits     String[]
  requirements String[]
  howToApply   String   @db.Text
  duration     String

  // Arabic content
  titleAr        String
  universityAr   String
  countryAr      String
  descriptionAr  String   @db.Text
  eligibilityAr  String[]
  benefitsAr     String[]
  requirementsAr String[]
  howToApplyAr   String   @db.Text
  durationAr     String

  // Metadata
  deadline       DateTime
  fundingType    FundingType
  levels         StudyLevel[]
  field          FieldOfStudy
  applicationUrl String
  image          String

  // Flags
  isFeatured  Boolean @default(false)
  isPublished Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  savedBy SavedScholarship[]
  posters Poster[]

  @@index([fundingType, field])
  @@index([deadline])
  @@index([isFeatured])
  @@index([isPublished])
}

// ============ SAVED SCHOLARSHIPS ============
model SavedScholarship {
  id            String            @id @default(cuid())
  userId        String
  scholarshipId String
  status        ApplicationStatus @default(SAVED)
  notes         String?           @db.Text
  savedAt       DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId])
  @@index([scholarshipId])
  @@index([status])
}

enum ApplicationStatus {
  SAVED
  APPLYING
  APPLIED
  ACCEPTED
  REJECTED
}

enum FundingType {
  FULLY_FUNDED
  PARTIALLY_FUNDED
}

enum StudyLevel {
  BACHELOR
  MASTER
  PHD
}

enum FieldOfStudy {
  ENGINEERING
  MEDICINE
  BUSINESS
  ARTS
  SCIENCE
  LAW
  EDUCATION
  TECHNOLOGY
}

enum PosterCategory {
  SCHOLARSHIP_INFO
  TURKEY
  EUROPE
  USA_CANADA
  ASIA
  APPLICATION_TIPS
  DEADLINE_REMINDER
  SUCCESS_STORIES
  GENERAL
}

// ============ COUNTRIES ============
model Country {
  id     String  @id @default(cuid())
  code   String  @unique // e.g., "uk", "usa"
  name   String          // English name
  nameAr String          // Arabic name
  flag   String?         // Emoji or URL
}

// ============ CONTACT FORM ============
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// ============ NEWSLETTER ============
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([isActive])
}

// ============ TESTIMONIALS ============
model Testimonial {
  id              String   @id @default(cuid())
  name            String
  nameAr          String
  university      String
  universityAr    String
  country         String
  countryAr       String
  quote           String   @db.Text
  quoteAr         String   @db.Text
  avatar          String
  scholarshipYear Int
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([isPublished])
}

// ============ BLOG POSTS ============
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique

  // English content
  title       String
  excerpt     String   @db.Text
  content     String   @db.Text
  category    String
  author      String
  readTime    String

  // Arabic content
  titleAr     String
  excerptAr   String   @db.Text
  contentAr   String   @db.Text
  categoryAr  String
  authorAr    String
  readTimeAr  String

  // Media & Tags
  image       String
  tags        String[]

  // Status
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(false)

  // Timestamps
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([isFeatured])
  @@index([slug])
  @@index([createdAt])
}

// ============ ADVERTISEMENTS ============
model Advertisement {
  id        String   @id @default(cuid())
  title     String   // English title
  titleAr   String   // Arabic title
  imageUrl  String   // Ad banner image URL
  linkUrl   String?  // Optional click-through URL
  isActive  Boolean  @default(true)
  order     Int      @default(0) // Display order in carousel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

// ============ UNIVERSITIES ============
model University {
  id        String   @id @default(cuid())
  name      String   @unique // English name (must match scholarship.university)
  nameAr    String            // Arabic name
  country   String
  countryAr String
  qsRank    Int?              // QS World Ranking (nullable)
  timesRank Int?              // Times Higher Education Ranking (nullable)
  logo      String?           // University logo URL
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([qsRank])
}

// ============ POSTERS/INFOGRAPHICS ============
model Poster {
  id            String         @id @default(cuid())

  // Bilingual content
  title         String         // English title
  titleAr       String         // Arabic title
  description   String?        @db.Text  // English description (optional)
  descriptionAr String?        @db.Text  // Arabic description (optional)

  // Image (external URL - portrait ~1580x2048 or 3:4 ratio)
  imageUrl      String

  // Category
  category      PosterCategory

  // Optional link to related scholarship
  scholarshipId String?
  scholarship   Scholarship?   @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)

  // External link (alternative to scholarship link)
  externalUrl   String?

  // Status & ordering
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)  // For homepage display
  order         Int            @default(0)

  // Timestamps
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isActive])
  @@index([isFeatured])
  @@index([category])
  @@index([order])
}

// ============ ANALYTICS ============
// Track page views
model PageView {
  id        String   @id @default(cuid())
  sessionId String   // Anonymous session identifier
  path      String   // Page path e.g., "/en/turkey"
  referrer  String?  // Where visitor came from
  userAgent String?  // Browser info
  locale    String   // "en" or "ar"
  createdAt DateTime @default(now())

  @@index([path])
  @@index([sessionId])
  @@index([createdAt])
  @@index([locale])
}

// Track file downloads
model DownloadEvent {
  id           String   @id @default(cuid())
  sessionId    String   // Link to visitor session
  fileName     String   // e.g., "turkiye-burslari-guide.pdf"
  filePath     String   // Full path: "/downloads/turkey/..."
  fileType     String   // "pdf", "docx"
  category     String   // "guide", "form", "letter"
  referrerPage String?  // Which page triggered the download
  createdAt    DateTime @default(now())

  @@index([fileName])
  @@index([category])
  @@index([createdAt])
  @@index([sessionId])
}

// ============ UNIVERSITY ADMISSIONS (Turkish Universities) ============
model UniversityAdmission {
  id                     String   @id @default(cuid())

  // University Info
  universityNameEn       String   // English name
  universityNameTr       String   // Turkish name
  universityNameAr       String   // Arabic name
  city                   String   // City in English
  cityAr                 String   // City in Arabic

  // Program Info
  degree                 String   // bachelor, master, phd, all
  specialization         String?  // Optional specialization field

  // Dates
  registrationStart      DateTime
  registrationEnd        DateTime
  resultsDate            DateTime

  // Certificates & Application
  acceptedCertificates   String[] // Array of certificate codes
  detailsUrl             String   // University application page URL
  applicationType        String   // yos, direct, sat, turkiye-burslari
  localRanking           Int      // University's local ranking in Turkey

  // Application Fee
  applicationFee         Float?   // Fee amount (null = free)
  applicationFeeCurrency String?  // TRY, USD, EUR
  isFreeApplication      Boolean  @default(true)

  // Calendar Type & Summer Program Fields
  calendarType           String   @default("bachelor") // bachelor, masters-phd, summer
  programDuration        String?  // e.g., "4 weeks", "8 weeks" (for summer programs)
  languageOfInstruction  String[] // ["Turkish", "English", "Arabic"]

  // Status
  isActive               Boolean  @default(true)

  // Timestamps
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([city])
  @@index([degree])
  @@index([isActive])
  @@index([registrationStart])
  @@index([registrationEnd])
  @@index([isFreeApplication])
  @@index([calendarType])
}

// ============ AI SCHOLARSHIP MATCHER ============
model MatcherProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique

  // GPA Information
  gpaValue             Float    // Stored as percentage (0-100)
  gpaSystem            String   // us-4.0, us-5.0, percentage, letter, uk, german, french

  // Education
  currentLevel         String   // HIGH_SCHOOL, BACHELOR, MASTER, PHD
  targetLevel          String   // BACHELOR, MASTER, PHD
  fieldsOfStudy        String[] // Multiple: ENGINEERING, MEDICINE, etc.

  // Personal
  countryOfOrigin      String   // ISO country code
  languages            String[] // Array of languages
  age                  Int?     // Optional

  // Preferences
  fundingPreference    String   // FULLY_FUNDED_ONLY, ANY
  specialCircumstances String?  @db.Text

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchResults         MatchResult[]

  @@index([userId])
}

model MatchResult {
  id               String   @id @default(cuid())
  profileId        String

  matches          Json     // Array of {scholarshipId, score, explanation, factors}
  totalMatched     Int
  profileSnapshot  Json     // Profile state at match time

  aiModel          String   // groq, gemini
  processingTimeMs Int

  createdAt        DateTime @default(now())

  profile          MatcherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

// ============ CV/RESUME BUILDER ============
model Resume {
  id              String   @id @default(cuid())
  userId          String

  // Basic Info
  title           String   @default("My Resume") // Internal name for user
  slug            String   @unique // For public sharing URL

  // Personal Information
  fullName        String
  email           String
  phone           String?
  location        String?  // City, Country
  linkedIn        String?
  website         String?

  // Professional Summary (AI can generate this)
  summary         String?  @db.Text
  summaryAr       String?  @db.Text

  // Template & Settings
  template        String   @default("modern") // modern, classic, minimal
  isPublic        Boolean  @default(false)
  primaryColor    String   @default("#2563eb") // Theme color

  // Metadata
  lastExportedAt  DateTime?
  viewCount       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  education       ResumeEducation[]
  experience      ResumeExperience[]
  skills          ResumeSkill[]
  languages       ResumeLanguage[]
  certifications  ResumeCertification[]
  projects        ResumeProject[]
  awards          ResumeAward[]

  @@index([userId])
  @@index([slug])
  @@index([isPublic])
}

model ResumeEducation {
  id           String   @id @default(cuid())
  resumeId     String

  institution  String
  degree       String   // Bachelor's, Master's, PhD, etc.
  field        String   // Field of study
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean  @default(false)
  gpa          String?
  achievements String?  @db.Text
  order        Int      @default(0)

  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeExperience {
  id           String   @id @default(cuid())
  resumeId     String

  company      String
  position     String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean  @default(false)
  description  String?  @db.Text // Bullet points / responsibilities
  order        Int      @default(0)

  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeSkill {
  id        String @id @default(cuid())
  resumeId  String

  name      String
  level     String? // Beginner, Intermediate, Advanced, Expert
  category  String? // Technical, Soft Skills, Tools, etc.
  order     Int    @default(0)

  resume    Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeLanguage {
  id           String @id @default(cuid())
  resumeId     String

  language     String
  proficiency  String // Native, Fluent, Advanced, Intermediate, Basic
  order        Int    @default(0)

  resume       Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeCertification {
  id           String   @id @default(cuid())
  resumeId     String

  name         String
  issuer       String
  issueDate    DateTime?
  expiryDate   DateTime?
  credentialId String?
  url          String?
  order        Int      @default(0)

  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeProject {
  id           String   @id @default(cuid())
  resumeId     String

  name         String
  description  String?  @db.Text  // Project description and key achievements
  technologies String[] // Technologies/tools used
  url          String?  // Project link (GitHub, live demo, etc.)
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean  @default(false)
  order        Int      @default(0)

  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeAward {
  id           String   @id @default(cuid())
  resumeId     String

  title        String   // Award/honor name
  issuer       String   // Organization that gave the award
  date         DateTime?
  description  String?  @db.Text  // Brief description of the achievement
  order        Int      @default(0)

  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

// ============ STUDY MATERIALS MODERATION ============
enum MaterialStatus {
  PENDING
  APPROVED
  REJECTED
}

model StudyMaterial {
  id             String         @id @default(cuid())
  title          String
  type           String         // pdf, docx, pptx, video
  url            String
  description    String?        @db.Text
  subject        String
  facultyId      String?
  specialtyId    String?
  uploaderRole   String         @default("student")
  countryId      String
  countryName    String
  universityId   String
  universityName String
  degreeId       String
  degreeName     String
  semester       String
  status         MaterialStatus @default(PENDING)
  rejectionNote  String?
  reviewedAt     DateTime?
  uploadedAt     DateTime       @default(now())
  editedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Counters & ratings
  viewCount      Int            @default(0)
  downloadCount  Int            @default(0)
  averageRating  Float          @default(0)
  reviewCount    Int            @default(0)

  // User ownership (nullable for existing records)
  userId         String?
  userEmail      String?
  userName       String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  savedBy         SavedMaterial[]
  reviews         MaterialReview[]
  collectionItems CollectionItem[]

  @@index([status])
  @@index([countryId, universityId, degreeId])
  @@index([uploadedAt])
  @@index([userId])
}

// ============ PAST EXAMS ============
enum ExamType {
  MIDTERM
  FINAL
  QUIZ
  ASSIGNMENT
  PRACTICAL
}

model PastExam {
  id             String         @id @default(cuid())
  title          String
  type           String         // pdf, docx, pptx, folder
  url            String
  description    String?        @db.Text
  subject        String
  facultyId      String?
  specialtyId    String?
  uploaderRole   String         @default("student")
  countryId      String
  countryName    String
  universityId   String
  universityName String
  degreeId       String
  degreeName     String
  semester       String
  status         MaterialStatus @default(PENDING)
  rejectionNote  String?
  reviewedAt     DateTime?
  uploadedAt     DateTime       @default(now())
  editedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Exam-specific fields
  examType       ExamType
  year           String         // e.g. "2024" or "2024-2025"
  professorName  String?

  // Counters
  viewCount      Int            @default(0)
  downloadCount  Int            @default(0)

  // User ownership
  userId         String?
  userEmail      String?
  userName       String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([examType])
  @@index([year])
  @@index([countryId, universityId, degreeId])
  @@index([uploadedAt])
  @@index([userId])
  @@index([downloadCount])
}

// ============ SAVED MATERIALS (Bookmarks) ============
model SavedMaterial {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  savedAt    DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  material StudyMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
}

// ============ MATERIAL REVIEWS ============
model MaterialReview {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  rating     Int      // 1-5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  material StudyMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
  @@index([userId])
}

// ============ NOTIFICATIONS ============
enum NotificationType {
  MATERIAL_APPROVED
  MATERIAL_REJECTED
  NEW_REVIEW
  MATERIAL_SAVED
  REQUEST_FULFILLED
  POINTS_EARNED
  FLASHCARD_SHARED
  STREAK_MILESTONE
  GOAL_ACHIEVED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  relatedId String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ============ MATERIAL REQUESTS ============
enum RequestStatus {
  OPEN
  FULFILLED
  CLOSED
}

model MaterialRequest {
  id           String        @id @default(cuid())
  userId       String
  title        String
  description  String?       @db.Text
  countryId    String?
  universityId String?
  degreeId     String?
  semester     String?
  subject      String?
  status       RequestStatus @default(OPEN)
  fulfilledBy  String?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

// ============ STUDY GROUPS ============
model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  countryId   String?
  universityId String?
  degreeId    String?
  semester    String?
  chatLink    String
  platform    String   // whatsapp, telegram, discord
  createdBy   String
  memberCount Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([universityId])
  @@index([isActive])
  @@index([createdAt])
}

// ============ MATERIAL COLLECTIONS ============
model MaterialCollection {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String? @db.Text
  isPublic    Boolean @default(false)
  createdAt   DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
  @@index([isPublic])
}

model CollectionItem {
  id           String @id @default(cuid())
  collectionId String
  materialId   String
  order        Int    @default(0)

  collection MaterialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  material   StudyMaterial      @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([collectionId, materialId])
  @@index([collectionId])
}

// ============ PROFESSOR REVIEWS ============
model ProfessorReview {
  id             String         @id @default(cuid())
  professorName  String
  universityId   String
  universityName String
  courseName     String
  rating         Int            // 1-5
  difficulty     Int            // 1-5
  wouldTakeAgain Boolean
  comment        String?        @db.Text
  tags           String[]
  isAnonymous    Boolean        @default(false)
  userId         String
  userName       String?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         MaterialStatus @default(PENDING)
  rejectionNote  String?
  reviewedAt     DateTime?
  helpfulCount   Int            @default(0)
  unhelpfulCount Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  votes          ProfessorReviewVote[]

  @@index([professorName])
  @@index([universityId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

// ============ PROFESSOR REVIEW VOTES ============
model ProfessorReviewVote {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  isHelpful Boolean  // true = helpful, false = not helpful
  createdAt DateTime @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  review ProfessorReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
}

// ============ AI CHAT SESSIONS ============
model AIChatSession {
  id          String   @id @default(cuid())
  userId      String
  title       String
  contextType String   // "material", "exam", "paste", "none"
  contextId   String?  // materialId or examId
  contextText String?  @db.Text // pasted text or extracted PDF text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIChatMessage[]

  @@index([userId])
  @@index([createdAt])
}

model AIChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user" or "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  session AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

// ============ SMART FLASHCARDS ============
model FlashcardDeck {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  subject     String?
  isPublic    Boolean  @default(false)
  cloneCount  Int      @default(0)
  sourceId    String?  // original deck ID if cloned
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Flashcard[]

  @@index([userId])
  @@index([isPublic])
  @@index([createdAt])
}

model Flashcard {
  id        String   @id @default(cuid())
  deckId    String
  front     String   @db.Text
  back      String   @db.Text
  // SM-2 algorithm fields
  easeFactor  Float    @default(2.5)
  interval    Int      @default(0) // days
  repetitions Int     @default(0)
  nextReview  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deck    FlashcardDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@index([deckId])
  @@index([nextReview])
}

model FlashcardReview {
  id         String   @id @default(cuid())
  cardId     String
  userId     String
  quality    Int      // 0-5 SM-2 quality rating
  createdAt  DateTime @default(now())

  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
  @@index([createdAt])
}

// ============ STUDY PLANNER & ANALYTICS ============
model StudySession {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  duration  Int      // minutes
  date      DateTime @default(now())
  notes     String?  @db.Text
  source    String   @default("manual") // "manual" or "pomodoro"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model StudyGoal {
  id            String   @id @default(cuid())
  userId        String
  type          String   // "daily", "weekly"
  targetMinutes Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type, isActive])
}

model StudyStreak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastStudyDate DateTime?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyExam {
  id        String   @id @default(cuid())
  userId    String
  title     String
  subject   String
  date      DateTime
  notes     String?  @db.Text
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

// ============ SMART STUDY PATH ============
model SmartStudyPath {
  id              String   @id @default(cuid())
  userId          String
  title           String
  status          String   @default("active") // active, completed, archived
  totalDays       Int
  startDate       DateTime
  endDate         DateTime
  subjects        String[]
  aiModel         String?
  promptSnapshot  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  days StudyPathDay[]

  @@index([userId])
  @@index([userId, status])
}

model StudyPathDay {
  id          String    @id @default(cuid())
  pathId      String
  dayNumber   Int
  date        DateTime
  subject     String
  topic       String
  description String    @db.Text
  durationMin Int
  taskType    String    @default("study") // study, review, practice, exam-prep
  priority    String    @default("normal") // high, normal, low
  status      String    @default("pending") // pending, completed, struggled, skipped
  completedAt DateTime?
  userNotes   String?   @db.Text

  path SmartStudyPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@index([pathId])
  @@index([pathId, dayNumber])
}

model TopicMastery {
  id             String   @id @default(cuid())
  userId         String
  subject        String
  topic          String
  masteryPct     Float    @default(0) // 0-100
  totalStudyMin  Int      @default(0)
  sessionCount   Int      @default(0)
  avgFlashcardQ  Float    @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, topic])
  @@index([userId])
}

// ============ FOCUS ISLAND ============
model FocusIsland {
  id             String   @id @default(cuid())
  userId         String   @unique
  level          Int      @default(1)
  growthPoints   Int      @default(0)
  totalStudyMin  Int      @default(0)
  theme          String   @default("forest")
  buildings      Json     @default("[]")
  weather        String   @default("sunny")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ============ BATTLE ARENA ============
model BattleQuestion {
  id            String   @id @default(cuid())
  userId        String
  subject       String
  question      String   @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  difficulty    String   @default("medium")
  usedCount     Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([subject])
  @@index([difficulty])
}

model Battle {
  id                String    @id @default(cuid())
  challengerId      String
  opponentId        String
  subject           String
  status            String    @default("pending")
  questions         Json      @default("[]")
  challengerAnswers Json?
  opponentAnswers   Json?
  challengerScore   Int?
  opponentScore     Int?
  winnerId          String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  challenger User @relation("challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("opponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId])
  @@index([opponentId])
  @@index([status])
  @@index([createdAt])
}

// ============ IELTS/TOEFL PRACTICE ============
model IeltsToeflTest {
  id            String   @id @default(cuid())
  userId        String?
  examType      String   // "ielts" | "toefl"
  section       String   // "reading" | "writing" | "listening" | "speaking"
  title         String
  description   String?  @db.Text
  difficulty    String   @default("medium")
  timeMinutes   Int
  content       Json
  isOfficial    Boolean  @default(false)
  isPublic      Boolean  @default(true)
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  attempts IeltsToeflAttempt[]

  @@index([examType, section])
  @@index([userId])
  @@index([isPublic, examType])
  @@index([createdAt])
}

model IeltsToeflAttempt {
  id            String    @id @default(cuid())
  userId        String
  testId        String
  examType      String
  section       String
  answers       Json
  score         Float?
  maxScore      Float?
  aiGrading     Json?
  timeSpentSec  Int?
  status        String    @default("in_progress")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  test IeltsToeflTest  @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([userId, examType])
  @@index([testId])
  @@index([createdAt])
}

model IeltsToeflVocab {
  id            String   @id @default(cuid())
  word          String
  definition    String   @db.Text
  example       String?  @db.Text
  arabicMeaning String?  @db.Text
  category      String
  difficulty    String   @default("medium")
  createdAt     DateTime @default(now())

  progress IeltsToeflVocabProgress[]

  @@index([category])
  @@unique([word, category])
}

model IeltsToeflVocabProgress {
  id          String   @id @default(cuid())
  userId      String
  vocabId     String
  easeFactor  Float    @default(2.5)
  interval    Int      @default(0)
  repetitions Int      @default(0)
  nextReview  DateTime @default(now())
  lastReview  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab IeltsToeflVocab   @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabId])
  @@index([userId, nextReview])
}

// ============ IELTS/TOEFL SHARED MATERIALS ============
model IeltsToeflMaterial {
  id            String   @id @default(cuid())
  userId        String
  examType      String   // ielts, toefl, both
  section       String   // reading, writing, listening, speaking, general
  materialType  String   // pdf, video, audio, document, link, folder
  title         String
  description   String?  @db.Text
  url           String
  tags          Json?    // e.g. ["cambridge","ielts-15"]
  difficulty    String   @default("medium") // easy, medium, hard
  language      String   @default("en")     // en, ar, both
  status        String   @default("pending") // pending, approved, rejected
  viewCount     Int      @default(0)
  downloadCount Int      @default(0)
  userName      String?
  userEmail     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, examType])
  @@index([examType, section])
  @@index([userId])
  @@index([createdAt])
}
